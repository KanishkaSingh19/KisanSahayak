# ==============================================================================
# KisanSahayak MVP Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Choose between: "gemini", "openai", or "mock" (for offline/testing)
LLM_PROVIDER=gemini

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Required for voice input / Whisper speech-to-text)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model Configurations
GEMINI_MODEL=gemini-3.7-flash
# Backup model used when the main one is busy (leave empty to go straight to the offline template)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
OPENAI_MODEL=gpt-4o-mini

# Embedding Configuration
# Options: "local" (hashed word/character n-grams, no downloads),
#          "minilm" (Hugging Face multilingual MiniLM, ~470 MB one-time download), or "gemini"
EMBEDDING_PROVIDER=local

# Folder for Hugging Face model downloads (used by "minilm"); leave empty for the default cache
HF_CACHE_DIR=

# Application Settings
APP_NAME=KisanSahayak
APP_ENV=development
DEBUG=True

# RAG & Retrieval Parameters
RAG_TOP_K_DENSE=5
RAG_TOP_K_SPARSE=5
RAG_FINAL_TOP_K=3
RRF_K=60
